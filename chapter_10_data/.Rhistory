# Find the most frequent words used by speakers recorded as Chancellor of the Exchequer
# - filter() keeps just relevant speakers and valid words
# - anti_join() removes stop words
# - group_by() groups words by suggested speaker
# - summarize() counts how often each word was used
# - top_n() keeps the 35 most frequent results
# - ungroup() removes the grouping
chancellor_of_the_exchequeur <- words_1830 %>%
filter(str_detect(speaker, "Exchequer"), # Find speakers
str_detect(word, "[a-z]"), # Keep alphabetic words
suggested_speaker != "", # Remove unidentified speakers
suggested_speaker != "chancellor of the exchequerr") %>% # Remove OCR errpr
anti_join(stop_words) %>% # Remove stop words
anti_join(custom_stop_words) %>% # Remove custom stop words
group_by(suggested_speaker, word) %>% # Group by speaker and word
summarize(n = n()) %>% # Count word frequency
top_n(35) %>% # Keep top 35
ungroup() # Remove grouping
# Show five random results
chancellor_of_the_exchequeur %>%
sample_n(5)
# Reorder words within each speaker and visualize their most frequent words
# - mutate() reorders words based on frequency within each speaker
# - ggplot() creates the visualization
# - geom_col() creates bars showing word frequency
# - scale_x_reordered() displays the reordered word labels
# - coord_flip() flips the axes for readability
# - facet_wrap() creates a separate panel for each speaker
# - labs() labels the axes
# - ggtitle() adds the graph title
ggplot(data = chancellor_of_the_exchequeur %>%
mutate(word = reorder_within(word, n, suggested_speaker)), # Reorder words by speaker
aes(x = word, y = n)) + # Set axes
geom_col() + # Create bars
scale_x_reordered() + # Reorder word labels
coord_flip() + # Flip axes
facet_wrap(~suggested_speaker, scales = "free") + # Separate by speaker
labs(x = "word", y = "number of uses") + # Label axes
ggtitle("Favorite Words of Each Chancellor of the Exchequer in the 1830s") # Add title
# Convert a character date into a date object
date1 <- mdy("6/24/1819")
date1
# Extract the year from the date
year1 <- year(date1)
year1
# Load debate metadata for the 1830s
data("debate_metadata_1830")
# Add debate metadata and extract the year from each speech
# - left_join() automatically matches rows using the shared sentence_id column
# - mutate() creates a year column from speechdate
hansard_1830_w_year <- hansard_1830 %>%
left_join(debate_metadata_1830) %>% # Add the debate metadata
mutate(year = year(speechdate)) # Extract the year from the speech date
# Display the first six rows of the dataset
# - head() keeps the first six rows
# - str_trunc() shortens long text for readability
# - kable() formats the results as a table
hansard_1830_w_year %>%
head() %>% # Keep the first six rows
mutate(text = str_trunc(text, 120)) %>% # Shorten the text column
kable() # Format the results as a table
# Remove the old tokenized dataset from memory
# - rm() deletes the object
# - gc() frees memory that is no longer being used
rm(words_1830)
gc()
# Add speaker metadata and tokenize the text
# - left_join() automatically matches rows using the shared sentence_id column
# - select() keeps only the columns needed for analysis
# - unnest_tokens() splits the text into individual words
words_1830_w_year <- hansard_1830_w_year %>%
left_join(speaker_metadata_1830) %>% # Add the speaker metadata
select(speaker, suggested_speaker, text, year) %>% # Keep the relevant columns
unnest_tokens(word, text) # Tokenize the text into words
# Display the first six rows of the tokenized dataset
# - head() keeps the first six rows
# - select() keeps only the speaker, word, and year columns
# - kable() formats the results as a table
words_1830_w_year %>%
head() %>% # Keep the first six rows
select(speaker, word, year) %>% # Keep the speaker, word, and year columns
kable() # Format the results as a table
# Count the number of words spoken by each speaker per year
# - filter() removes rows without a suggested speaker
# - group_by() groups words by speaker and year
# - summarize() counts the total words for each speaker per year
# - arrange() sorts speakers from highest to lowest word count
words_per_speaker_1830 <- words_1830_w_year %>%
filter(suggested_speaker != "") %>% # Keep identified speakers
group_by(speaker, year) %>% # Group by speaker and year
summarize(speaker_words_per_year = n()) %>% # Count words
arrange(desc(speaker_words_per_year)) # Sort by word count
head(words_per_speaker_1830)
data("hansard_1820")
data("speaker_metadata_1820")
data("file_metadata_1820")
# Find the speaker metadata for Mrs. Walrand
# - regex() searches for speaker names matching "Mrs ... Walrand"
# - ignore_case = TRUE matches uppercase and lowercase text
mrs_walrand_speaker_metadata <- speaker_metadata_1820 %>%
filter(str_detect(speaker, regex("Mrs(.*)Walrand", ignore_case = TRUE))) # Keep Mrs. Walrand's metadata
# Add the speech text for Mrs. Walrand
# - left_join() automatically matches rows using the shared sentence_id column
# - select() keeps only the debate ID and text
mrs_walrand_sentences <- left_join(mrs_walrand_speaker_metadata,
file_metadata_1820, by = "sentence_id") %>% # Add the file metadata
left_join(hansard_1820, by = "sentence_id") %>% # Add the Hansard text
select(debate_id, text) # Keep the debate ID and text
# Display sample sentences spoken by Mrs. Walrand
# - head() keeps the first six rows
# - str_trunc() shortens long text for readability
# - kable() formats the results as a table
mrs_walrand_sentences %>%
head() %>% # Keep the first six rows
mutate(text = str_trunc(text, 120)) %>% # Shorten the text column
kable(caption = "Sentences uttered by Mrs. Walrand in the 1820 Hansard debates.") # Format the results as a table
# Extract the text from the debate of interest
# - left_join() adds file metadata to the Hansard data using sentence ID
# - filter() keeps only sentences from debate with the ID 5142
# - select() keeps only the text column
entire_debate <- hansard_1820 %>%
left_join(file_metadata_1820, by = "sentence_id") %>% # Add file metadata
filter(debate_id == 5142) %>% # Keep debate 5142
select(text) # Keep the text column
# Create a table containing the first 20 sentences of the debate
debate_table <- tibble(text = head(entire_debate$text, 20)) # Keep first 20 sentences
# Display the first 20 sentences of the debate as a formatted table
debate_table %>%
kable(caption = "Excerpt of Debate Text (First 20 Sentences)")
# Find Mrs. Walrand's 30 most frequently used words
# - left_join() automatically matches rows using the shared sentence_id column
# - unnest_tokens() splits the text into individual words
# - anti_join() removes common stop words
# - filter() removes numeric tokens
# - group_by() groups the words by speaker and word
# - summarize() counts the occurrences of each word
# - arrange() sorts the results from most to fewest occurrences
# - top_n() keeps the 30 most frequent words
mrs_walrand_top_words <- left_join(mrs_walrand_speaker_metadata, hansard_1820) %>%
unnest_tokens(word, text) %>% # Tokenize the text into words
anti_join(stop_words) %>% # Remove common stop words
filter(is.na(as.numeric(word))) %>% # Remove numeric tokens
group_by(speaker, word) %>% # Group by speaker and word
summarize(n = n()) %>% # Count the occurrences of each word
arrange(desc(n)) %>% # Sort from most to fewest occurrences
top_n(30) # Keep the 30 most frequent words
# Visualize Mrs. Walrand's most frequently used words
# - aes() maps words and word counts to the plot
# - geom_col() creates a bar chart
# - coord_flip() flips the axes for readability
# - labs() adds the title and axis labels
ggplot(data = mrs_walrand_top_words,
aes(x = reorder(word, n), # Order words by frequency
y = n)) + # Plot word counts
geom_col() + # Create the bars
coord_flip() + # Flip the axes
labs(title = "Mrs. Walrand's Top Words", # Add the chart title
subtitle = "From \"Motion Respecting the Trial and Condemnation of
Missionary Smith at Demerara\"", # Add a subtitle
x = "Word", # Label the x-axis
y = "Count") # Label the y-axis
# Load Hansard data and metadata for the 1840s
data("hansard_1840")
data("speaker_metadata_1840")
data("debate_metadata_1840")
# Add speaker and debate metadata to each decade of Hansard data
# - left_join() automatically matches rows using the shared sentence_id column
hansard_1820 <- hansard_1820 %>%
left_join(speaker_metadata_1820) %>% # Add speaker metadata
left_join(debate_metadata_1820) # Add debate metadata
hansard_1830 <- hansard_1830 %>%
left_join(speaker_metadata_1830) %>% # Add speaker metadata
left_join(debate_metadata_1830) # Add debate metadata
hansard_1840 <- hansard_1840 %>%
left_join(speaker_metadata_1840) %>% # Add speaker metadata
left_join(debate_metadata_1840) # Add debate metadata
# Combine the 1820s, 1830s, and 1840s Hansard data
# - bind_rows() stacks the rows from all three decades
hansard <- bind_rows(hansard_1820, hansard_1830, hansard_1840) # Combine the three datasets
# Create a dataset of speeches made before the Reform Act
# - select() keeps the columns needed for analysis
# - filter() keeps speeches from June 4, 1822 through June 3, 1832
# - mutate() extracts the year and labels the period
prereform <- hansard %>%
select(sentence_id, speechdate, debate, text, speaker, suggested_speaker) %>% # Keep text, date, debate, and speaker information
filter(speechdate >= as.Date("1822-06-04"), # Keep speeches from ten years before reform
speechdate < as.Date("1832-06-04")) %>% # Keep speeches made before the reform date
mutate(year = year(speechdate), # Extract the year from the speech date
period = "prereform") # Label the speeches as prereform
# Create a dataset of speeches made after the Reform Act
# - select() keeps the columns needed for analysis
# - filter() keeps speeches from June 4, 1832 through June 4, 1842
# - mutate() extracts the year and labels the period
postreform <- hansard %>%
select(sentence_id, speechdate, debate, text, speaker, suggested_speaker) %>% # Keep text, date, debate, and speaker information
filter(speechdate >= as.Date("1832-06-04"), # Keep speeches made on or after the reform date
speechdate <= as.Date("1842-06-04")) %>% # Keep speeches through ten years after reform
mutate(year = year(speechdate), # Extract the year from the speech date
period = "postreform") # Label the speeches as postreform
# Combine the prereform and postreform data
# - bind_rows() stacks the rows from both periods
both_periods <- bind_rows(prereform, postreform) # Combine the two periods
# Count the words used in each period
# - select() keeps only the period and text columns
# - unnest_tokens() splits the text into individual words
# - anti_join() removes common stop words
# - count() counts the occurrences of each word by period
both_periods_word_count <- both_periods %>%
select(period, text) %>% # Keep the period and text columns
unnest_tokens(word, text) %>% # Break the text into words
anti_join(stop_words, by = "word") %>% # Remove common stop words
count(period, word, name = "wordcount") # Count each word by period
# Calculate the total number of words in each period
# - group_by() groups the word counts by period
# - summarize() adds the word counts within each period
both_periods_word_count_totals <- both_periods_word_count %>%
group_by(period) %>% # Group the words by period
summarize(total = sum(wordcount)) # Calculate the total words
# Visualize the total number of words spoken in each period
# - aes() maps periods and word totals to the plot
# - geom_col() creates a bar chart
# - scale_fill_grey() applies a grayscale color palette
# - scale_x_discrete() orders the periods on the x-axis
# - scale_y_continuous() formats the y-axis labels
# - geom_text() adds labels to each bar
# - labs() adds the title and axis labels
ggplot(both_periods_word_count_totals,
aes(x = period, y = total)) +
geom_col(aes(fill = period)) + # Create one bar for each period
scale_fill_grey() + # Apply a grayscale color palette
scale_x_discrete(limits = c("prereform", "postreform")) + # Order the periods on the x-axis
scale_y_continuous(labels = comma) + # Format large numbers with commas
geom_text(aes(label = paste0(comma(total), " words")), # Label each bar with the word count
colour = "white", # Use white text
vjust = 1.5) + # Position the labels inside the bars
labs(title = "How Many Words Were Spoken in Each Period?", # Add the chart title
x = "", # Leave the x-axis label blank
y = "Words") # Label the y-axis
# Find the difference in total words spoken between the two periods
# - subtract the prereform total from the postreform total
both_periods_word_count_totals$total[2] - both_periods_word_count_totals$total[1]
# Find the most frequently used words in each period
# - group_by() separates the data by period
# - slice_max() keeps the words with the highest counts
top_words <- both_periods_word_count %>%
group_by(period) %>%
slice_max(order_by = wordcount, # Sort by word count
n = 10) # Keep the 10 most frequent words
# Display the top words as a formatted table
# - kable() formats the results as a table
# - kable_styling() adjusts the table appearance
top_words %>%
kable(caption = "The Top Ten Words Spoken in Prereform and Postreform Parliament",
digits = 0) %>% # Format the results as a table
kable_styling(full_width = FALSE, position = "left") # Adjust the table appearance
# Combine the prereform and postreform data
# - bind_rows() stacks the rows from both periods
both_periods <- bind_rows(prereform, postreform)
# Count the number of words spoken by each speaker in each year and period
# - filter() removes missing and empty speaker names
# - unnest_tokens() splits the text into individual words
# - count() counts the words for each speaker by year and period
both_periods_speakers <- both_periods %>%
filter(!is.na(suggested_speaker), # Remove missing speaker names
suggested_speaker != "") %>% # Remove empty speaker names
unnest_tokens(word, text) %>% # Tokenize the text into words
count(period, suggested_speaker, year, name = "wordcount") # Count words by speaker, year, and period
# Display the speakers with the highest word counts
# - arrange() sorts the data from highest to lowest word count
# - head() keeps the first six rows
both_periods_speakers %>%
arrange(desc(wordcount)) %>% # Sort from highest to lowest word count
head() # Keep the first six rows
# Calculate the total number of words spoken by each speaker
# - group_by() groups the data by speaker
# - summarize() adds the word counts across all years and periods
words_per_speaker <- both_periods_speakers %>%
group_by(suggested_speaker) %>%
summarize(wordsperspeaker = sum(wordcount))
# Find the five speakers with the highest word counts
# - slice_max() keeps the speakers with the largest word counts
top_speakers <- words_per_speaker %>%
slice_max(wordsperspeaker, n = 5) # Keep the five most prolific speakers
top_speakers
# Find the prereform speakers
# - filter() keeps only prereform speakers
# - select() keeps the speaker names
# - distinct() removes duplicate speakers
prereform_speakers <- both_periods_speakers %>%
filter(period == "prereform") %>% # Keep only prereform speakers
select(suggested_speaker) %>% # Keep speaker names
distinct() # Remove duplicates
# Find the postreform speakers
# - filter() keeps only postreform speakers
# - select() keeps the speaker names
# - distinct() removes duplicate speakers
postreform_speakers <- both_periods_speakers %>%
filter(period == "postreform") %>% # Keep only postreform speakers
select(suggested_speaker) %>% # Keep speaker names
distinct() # Remove duplicates
# Find speakers who only appear prereform
# - anti_join() removes speakers who also appear postreform
# - mutate() labels the speaker group
prereform_only_speakers <- prereform_speakers %>%
anti_join(postreform_speakers,
by = "suggested_speaker") %>% # Remove postreform speakers
mutate(class = "prereform only") # Label the speaker group
head(prereform_only_speakers)
# Count the number of speakers in the dataset
nrow(prereform_only_speakers)
# Find the postreform-only speakers
# - anti_join() removes speakers who also appear prereform
# - mutate() labels the speaker group
postreform_only_speakers <- postreform_speakers %>%
anti_join(prereform_speakers,
by = "suggested_speaker") %>% # Remove prereform speakers
mutate(class = "postreform only") # Label the speaker group
head(postreform_only_speakers)
# Count the number of speakers in the postreform dataset
# - nrow() returns the number of rows in the data frame
nrow(postreform_only_speakers)
# Count the number of speakers in the prereform dataset
# - nrow() returns the number of rows in the data frame
nrow(postreform_only_speakers) - nrow(prereform_only_speakers)
# Find speakers who appear in both periods
# - inner_join() keeps only speakers found in both datasets
# - mutate() labels the speaker group
continuous_speakers <- prereform_speakers %>%
inner_join(postreform_speakers,
by = "suggested_speaker") %>% # Keep speakers found in both periods
mutate(class = "both periods") # Label the speaker group
# Count the number of speakers in both periods
# - nrow() returns the number of rows in the data frame
nrow(continuous_speakers)
# Combine the speaker groups
# - rbind() stacks three datasets into one
classified_speakers <- rbind(prereform_only_speakers,
postreform_only_speakers,
continuous_speakers)
# Count the number of speakers in each group
# - group_by() groups the data by speaker category
# - summarize() counts the speakers in each category
# - arrange() sorts the categories alphabetically
classified_speakers_count <- classified_speakers %>%
group_by(class) %>% # Group by speaker category
summarize(speakercount = n()) %>% # Count the speakers in each category
arrange(class) # Sort the categories alphabetically
# Order the groups for the plot
# - factor() specifies the order the groups will appear in the plot
classified_speakers_count$class <- factor(classified_speakers_count$class,
levels = c("prereform only",
"postreform only",
"both periods"))
# Visualize the number of speakers in each group
# - aes() maps speaker groups and counts to the plot
# - geom_col() creates a bar chart
# - scale_fill_grey() applies a grayscale color palette
# - geom_text() adds labels to each bar
# - labs() adds the title and axis labels
ggplot(classified_speakers_count,
aes(x = class, y = speakercount)) +
geom_col(aes(fill = class)) + # Create one bar for each speaker group
scale_fill_grey() + # Apply a grayscale color palette
geom_text(aes(label = paste0(speakercount, " speakers")), # Label each bar with the speaker count
colour = "white", # Use white text
vjust = 1.5) + # Position the labels inside the bars
labs(title = "How Many Speakers are in Each Category?", # Add the chart title
x = "", # Leave the x-axis label blank
y = "Speakers") # Label the y-axis
# Add speaker group labels to the full dataset
# - filter() removes missing speakers
# - left_join() adds the speaker group labels
# - ungroup() removes any grouping
all_speakers_annotated <- both_periods_speakers %>%
filter(!is.na(suggested_speaker)) %>% # Remove missing speakers
left_join(classified_speakers, by = "suggested_speaker") %>% # Add speaker group labels
ungroup() # Remove grouping
head(all_speakers_annotated)
# Count the total number of words spoken by each speaker
# - group_by() groups the data by speaker and category
# - summarize() adds the total words spoken
wordcount_per_speaker <- all_speakers_annotated %>%
group_by(class, suggested_speaker) %>% # Group by category and speaker
summarize(wordcount_per_speaker = sum(wordcount)) # Sum words spoken
# Keep the top speakers from each category
# - filter() removes missing speakers
# - group_by() groups speakers by category
# - arrange() sorts speakers by word count
# - slice_head() keeps the top five speakers
# - mutate() labels the selected speakers
top_speakers <- wordcount_per_speaker %>%
filter(!is.na(suggested_speaker)) %>% # Remove missing speakers
group_by(class) %>% # Group by speaker category
arrange(desc(wordcount_per_speaker)) %>% # Sort by word count
slice_head(n = 5) %>% # Keep the top five speakers
mutate(top = TRUE) # Label the top speakers
head(top_speakers)
# Clean up speaker names
# - select() keeps the speaker names
# - filter() removes government titles
# - group_by() groups rows by speaker
# - sample_n() keeps one name for each speaker
speaker_key <- rbind(prereform, postreform) %>%
select(speaker, suggested_speaker) %>% # Keep speaker names
filter(!str_detect(speaker, "Secretary|Chancellor|Minister")) %>% # Remove government titles
group_by(suggested_speaker) %>% # Group by speaker
sample_n(1) # Keep one name per speaker
# Inspect the data
speaker_key %>%
filter(str_detect(suggested_speaker, "peel_"))
# Add the top speaker labels and representative speaker names
# - left_join() adds information about the top speakers
# - the second left_join() adds representative speaker names
speakers_w_top_and_speaker_key <- all_speakers_annotated %>%
left_join(top_speakers,
by = c("suggested_speaker", "class")) %>% # Add the top speaker labels
left_join(speaker_key) # Add the representative speaker names
# Display the records for Robert Peel
# - filter() keeps speaker IDs containing "peel_"
# - select() keeps only the relevant columns
# - kable() formats the results as a table
speakers_w_top_and_speaker_key %>%
filter(str_detect(suggested_speaker, "peel_")) %>% # Keep Robert Peel
select(speaker, top, year, wordcount, class) %>% # Keep the relevant columns
kable() # Format the results as a table
# Visualize how much speakers spoke over time
# - aes() maps the year, word count, and speaker group to the plot
# - geom_jitter() plots each speaker-year observation
# - scale_color_grey() applies a grayscale color palette
# - geom_label_repel() labels the top speakers
# - guides() removes unused legends
# - theme() customizes the plot appearance
# - labs() adds the title and subtitle
ggplot(speakers_w_top_and_speaker_key,
aes(x = year, # Plot the year
y = wordcount, # Plot the number of words spoken
color = class, # Color points by speaker group
shape = class)) + # Shape points by speaker group
geom_jitter(size = 3) + # Plot each speaker-year observation
scale_color_grey(guide = guide_legend()) + # Apply a grayscale color palette
geom_label_repel(
data = subset(speakers_w_top_and_speaker_key, top == TRUE), # Keep only the top speakers
aes(label = speaker, # Label each point with the speaker name
color = class) # Match the label color to the speaker group
) +
guides(fill = "none",
label = "none",
size = "none") + # Remove unused legends
theme(legend.position = "bottom") + # Place the legend below the plot
labs(title = "How Much Did Speakers Speak", # Add the chart title
subtitle = "Before and After the Second Reform Act of 1832?") # Add a subtitle
# Visualize how much speakers spoke over time
# - aes() maps the year, word count, and speaker group to the plot
# - geom_jitter() plots each speaker-year observation
# - scale_color_grey() applies a grayscale color palette
# - geom_label_repel() labels the top speakers
# - guides() removes unused legends
# - theme() customizes the plot appearance
# - labs() adds the title and subtitle
ggplot(speakers_w_top_and_speaker_key,
aes(x = year, # Plot the year
y = wordcount, # Plot the number of words spoken
color = class, # Color points by speaker group
shape = class)) + # Shape points by speaker group
geom_jitter(size = 3) + # Plot each speaker-year observation
scale_color_grey(guide = guide_legend()) + # Apply a grayscale color palette
geom_label_repel(data = subset(speakers_w_top_and_speaker_key, top == TRUE), # Keep only the top speakers
aes(label = speaker, # Label each point with the speaker name
color = class)) + # Match the label color to the speaker group
guides(fill = "none",
label = "none",
size = "none") + # Remove unused legends
theme(legend.position = "bottom") + # Place the legend below the plot
labs(title = "How Much Did Speakers Speak", # Add the chart title
subtitle = "Before and After the Second Reform Act of 1832?") # Add a subtitle
# Load the usdoj library
library(usdoj)
# Retrieve the 10 most recent Department of Justice blog entries
# - n_results specifies how many blog entries to retrieve
# - search_direction = "DESC" returns the newest entries first
blog_entries <- doj_blog_entries(n_results = 10, # Retrieve 10 blog entries
search_direction = "DESC") # Sort from newest to oldest
head(blog_entries$teaser, 5)
