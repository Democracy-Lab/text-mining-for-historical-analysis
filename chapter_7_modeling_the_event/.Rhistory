# - distinct() keeps one row for each speaker
postreform_speakers <- both_periods_speakers %>%
filter(period == "postreform") %>% # Keep the postreform period
distinct(suggested_speaker) # Keep distinct speakers
# Find the speakers who appear only in the prereform period
# - anti_join() keeps speakers who do not appear in the postreform period
# - mutate() labels the speakers by category
prereform_only_speakers <- prereform_speakers %>%
anti_join(postreform_speakers, by = "suggested_speaker") %>% # Keep speakers unique to the prereform period
mutate(class = "prereform only") # Label the speaker category
# Display a random sample of prereform-only speakers
# - sample_n() selects 10 random speakers
prereform_only_speakers %>%
sample_n(10) # Display 10 random speakers
# Count the number of speakers in the prereform only dataset
nrow(prereform_only_speakers)
# Find the speakers who appear only in the postreform period
# - anti_join() keeps speakers who do not appear in the prereform period
# - mutate() labels the speakers by category
postreform_only_speakers <- postreform_speakers %>%
anti_join(prereform_speakers, by = "suggested_speaker") %>% # Keep speakers unique to the postreform period
mutate(class = "postreform only") # Label the speaker category
head(postreform_only_speakers)
# Count the number of speakers in the postreform only dataset
nrow(postreform_only_speakers)
# Find the number of speakers unique to each period
nrow(postreform_only_speakers) - nrow(prereform_only_speakers)
knitr::opts_chunk$set(echo = TRUE)
# load libraries for cleaning, analyzing and visualizing data
library(tidyverse)
library(tidytext)
library(lubridate)
# load libraries for measurement and the hansard corpus
library(dhmeasures)
library(hansardr)
# load libraries for formatting and styling plots
library(scales)
library(ggrepel)
library(kableExtra)
# load the hansard debate text
data("hansard_1820")
data("hansard_1830")
data("hansard_1840")
# load the hansard debate metadata
data("debate_metadata_1820")
data("debate_metadata_1830")
data("debate_metadata_1840")
# load the hansard speaker metadata
data("speaker_metadata_1820")
data("speaker_metadata_1830")
data("speaker_metadata_1840")
# Add metadata to the 1820s Hansard data
# - left_join() adds debate and speaker metadata
# - mutate() extracts the year from the speech date
# - select() keeps only the relevant columns
annotated_1820 <- hansard_1820 %>%
left_join(debate_metadata_1820) %>% # Add debate metadata
mutate(year = year(speechdate)) %>% # Extract the year
left_join(speaker_metadata_1820) %>% # Add speaker metadata
select(text, year, speechdate, suggested_speaker) # Keep the relevant columns
# Do the same for the 1830s Hansard data
annotated_1830 <- hansard_1830 %>%
left_join(debate_metadata_1830) %>%
mutate(year = year(speechdate)) %>%
left_join(speaker_metadata_1830) %>%
select(text, year, speechdate, suggested_speaker)
# Do the same for the 1840s Hansard data
annotated_1840 <- hansard_1840 %>%
left_join(debate_metadata_1840) %>%
mutate(year = year(speechdate)) %>%
left_join(speaker_metadata_1840) %>%
select(text, year, speechdate, suggested_speaker)
# Create the prereform dataset
# - bind_rows() combines the 1820s and 1830s data
# - filter() keeps speeches between 1822 and the Second Reform Act
# - mutate() labels the time period
prereform <- bind_rows(annotated_1820, annotated_1830) %>%
filter(speechdate >= as.Date("1822-06-04"), # Keep speeches on or after June 4, 1822
speechdate <= as.Date("1832-06-04")) %>% # Keep speeches on or before June 4, 1832
mutate(period = "prereform") # Label the period
# Create the postreform dataset
# - bind_rows() combines the 1830s and 1840s data
# - filter() keeps speeches between the Second Reform Act and 1842
# - mutate() labels the time period
postreform <- bind_rows(annotated_1830, annotated_1840) %>%
filter(speechdate >= as.Date("1832-06-04"), # Keep speeches on or after June 4, 1832
speechdate <= as.Date("1842-06-04")) %>% # Keep speeches on or before June 4, 1842
mutate(period = "postreform") # Label the period
# Tokenize and clean the prereform speeches
# - unnest_tokens() tokenizes the text into words
# - anti_join() removes common stop words
# - filter() removes words containing only digits
prereform_words <- prereform %>%
unnest_tokens(word, text) %>% # Tokenize text
anti_join(stop_words) %>% # Remove stop words
filter(!str_detect(word, "^[0-9]+$")) # Remove words containing only digits
# Count the words in the prereform period
# - count() counts the occurrences of each word
prereform_word_count <- prereform_words %>%
count(period, word, name = "wordcount") # Count words by period
# Tokienize and clean the postreform speeches
# - unnest_tokens() tokenizes text
# - anti_join() removes common stop words
# - filter() removes words containing only digits
postreform_words <- postreform %>%
unnest_tokens(word, text) %>% # Tokenize text
anti_join(stop_words) %>% # Remove stop words
filter(!str_detect(word, "^[0-9]+$")) # Remove words containing only digits
# Count the words in the postreform period
# - count() counts the occurrences of each word
postreform_word_count <- postreform_words %>%
count(period, word, name = "wordcount") # Count words by period
# Count the total number of words in each period
# - bind_rows() combines the two datasets
# - group_by() groups the data by period
# - summarize() adds the word counts within each period
both_periods_word_count_totals <- prereform_word_count %>%
bind_rows(postreform_word_count) %>% # Combine the two periods
group_by(period) %>% # Group by period
summarize(total = sum(wordcount)) # Calculate the total words
# Visualize the total number of words spoken in each period
# - geom_col() creates a bar chart
# - scale_x_discrete() orders the periods on the x-axis
# - scale_fill_grey() uses grayscale shading
# - scale_y_continuous() formats the y-axis with commas
# - geom_text() labels each bar with its total word count
# - labs() adds the title and axis labels
ggplot(both_periods_word_count_totals,
aes(x = period, y = total, fill = period)) + # Plot periods on the x-axis, word totals on the y-axis, fill bars by period
geom_col(show.legend = FALSE) + # Create a bar chart
scale_x_discrete(limits = c("prereform", "postreform")) + # Order the periods on the x-axis
scale_fill_grey() + # Use grayscale shading
scale_y_continuous(labels = comma) + # Format the y-axis with commas
geom_text(aes(label = paste0(comma(total), " words")), # Label each bar
color = "white", # Make the text white
vjust = 1.5) + # # Vertically position the text inside the bar
labs(title = "How Many Words Were Spoken in Each Period?", # Add a chart title
x = "Period", # Label the x-axis
y = "Words") # Label the y-axis
# Extract totals by position in the data frame and fine the difference between them
# [1] = first period, [2] = second period
print(both_periods_word_count_totals$total[1] - both_periods_word_count_totals$total[2])
# Keep the 10 most frequent words from each period
# - bind_rows() combines the prereform and postreform word counts
# - group_by() groups the words by period
# - slice_max() keeps the top 10 words in each period
# - ungroup() removes the grouping
top_words <- prereform_word_count %>%
bind_rows(postreform_word_count) %>% # Combine the two periods
group_by(period) %>% # Group by period
slice_max(order_by = wordcount, n = 10) %>% # Keep the top 10 words
ungroup() # Remove the grouping
# Display the most frequent words in each period
# - kable() formats the results as a table
top_words %>%
kable(caption = "The Top Ten Words Spoken in Prereform and Postreform Parliament", # Add a table caption
format.args = list(big.mark = ",", # Display commas in large numbers
scientific = FALSE)) # Don't use scientific notation
# Count the words spoken by each speaker in each year and period
# - bind_rows() combines the prereform and postreform data
# - unnest_tokens() Tokenize text into words
# - count() counts the words by period, speaker, and year
both_periods_speakers <- prereform %>%
bind_rows(postreform) %>% # Combine the two periods
unnest_tokens(word, text) %>% # Tokenize the text
count(period, suggested_speaker, year, name = "wordcount") # Count words by period, speaker, and year
head(both_periods_speakers)
# Find the speakers who spoke the most across both periods
# - group_by() groups the data by speaker
# - summarize() adds the total words spoken by each speaker
# - slice_max() keeps the five speakers with the highest word counts
top_speakers <- both_periods_speakers %>%
group_by(suggested_speaker) %>% # Group by speaker
summarize(wordsperspeaker = sum(wordcount)) %>% # Count the total words spoken
slice_max(wordsperspeaker, n = 5) # Keep the top five speakers
# Inspect the data
head(top_speakers)
# Find the distinct speakers in the prereform period
# - filter() keeps only the prereform speeches
# - distinct() keeps one row for each speaker
prereform_speakers <- both_periods_speakers %>%
filter(period == "prereform") %>% # Keep the prereform period
distinct(suggested_speaker) # Keep distinct speakers
# Find the distinct speakers in the postreform period
# - filter() keeps only the postreform speeches
# - distinct() keeps one row for each speaker
postreform_speakers <- both_periods_speakers %>%
filter(period == "postreform") %>% # Keep the postreform period
distinct(suggested_speaker) # Keep distinct speakers
# Find the speakers who appear only in the prereform period
# - anti_join() keeps speakers who do not appear in the postreform period
# - mutate() labels the speakers by category
prereform_only_speakers <- prereform_speakers %>%
anti_join(postreform_speakers, by = "suggested_speaker") %>% # Keep speakers unique to the prereform period
mutate(class = "prereform only") # Label the speaker category
# Display a random sample of prereform-only speakers
# - sample_n() selects 10 random speakers
prereform_only_speakers %>%
sample_n(10) # Display 10 random speakers
# Count the number of speakers in the prereform only dataset
nrow(prereform_only_speakers)
# Find the speakers who appear only in the postreform period
# - anti_join() keeps speakers who do not appear in the prereform period
# - mutate() labels the speakers by category
postreform_only_speakers <- postreform_speakers %>%
anti_join(prereform_speakers, by = "suggested_speaker") %>% # Keep speakers unique to the postreform period
mutate(class = "postreform only") # Label the speaker category
head(postreform_only_speakers)
# Count the number of speakers in the postreform only dataset
nrow(postreform_only_speakers)
# Find the number of speakers unique to the prereform period
nrow(postreform_only_speakers) - nrow(prereform_only_speakers)
# Find the speakers who appear in both periods
# - inner_join() keeps only speakers found in both datasets
# - mutate() labels the speakers by category
continuous_speakers <- prereform_speakers %>%
inner_join(postreform_speakers, by = "suggested_speaker") %>% # Keep speakers found in both periods
mutate(class = "both periods") # Label the speaker category
nrow(continuous_speakers)
# Combine the speaker categories into one dataset
# - bind_rows() stacks the three datasets into one table
all_classes <- bind_rows(prereform_only_speakers,
postreform_only_speakers,
continuous_speakers)
# Count the number of speakers in each category
# - group_by() groups the data by speaker category
# - summarize() counts the speakers in each category
all_classes_count <- all_classes %>%
group_by(class) %>% # Group by speaker category
summarize(speakercount = n()) # Count the speakers
# Visualize the number of speakers in each category
# - geom_col() creates a bar chart
# - scale_x_discrete() places the categories in the desired order
# - scale_fill_grey() uses grayscale shading
# - geom_text() labels each bar with the speaker count
# - labs() adds the title and axis labels
ggplot(all_classes_count,
aes(x = class, y = speakercount, fill = class)) + # Plot categories, speaker counts, and bar fill
geom_col(show.legend = FALSE) + # Create a bar chart
scale_x_discrete(limits = c("prereform only", "postreform only", "both periods")) + # Place the categories in order
scale_fill_grey() + # Use grayscale shading
geom_text(aes(label = paste(speakercount, "speakers")), # Label each bar
color = "white", # Make the text white
vjust = 1.5) + # Position the text inside the bar
labs(title = "How Many Speakers are in Each Category?", # Add a chart title
x = "Category", # Label the x-axis
y = "Speakers") # Label the y-axis
knitr::opts_chunk$set(echo = TRUE)
