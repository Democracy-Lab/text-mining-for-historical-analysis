# - slice_max() keeps the five speakers with the highest word counts
# - mutate() labels the selected speakers
top_speakers <- wordcount_per_speaker %>%
group_by(class) %>% # Group by speaker category
slice_max(wordcount_per_speaker, n = 5) %>% # Keep the top five speakers
mutate(top = TRUE) # Label the top speakers
head(top_speakers)
# Create a lookup table of unique speaker names
# - bind_rows() combines the speaker metadata from all decades
# - select() keeps only the speaker names
# - distinct() keeps one row for each speaker
speaker_key <- bind_rows(annotated_1820, annotated_1830, annotated_1840) %>%
select(suggested_speaker) %>% # Keep the speaker names
distinct() # Keep unique speakers
# Display speaker names containing "peel_"
speaker_key %>%
filter(str_detect(suggested_speaker, "peel_"))
# Add the top-speaker labels and speaker names
# - left_join() adds the top-speaker labels
# - left_join() adds the cleaned speaker names
speakers_w_top_and_speaker_key <- all_speakers_annotated %>%
left_join(top_speakers, by = c("suggested_speaker", "class")) %>% # Add the top-speaker labels
left_join(speaker_key) # Add the speaker names
# Inspect the data for speakers whose names contain "peel_"
# - filter() keeps matching speakers
# - select() keeps the relevant columns
# - head() displays the first six rows
# - kable() formats the results as a table
speakers_w_top_and_speaker_key %>%
filter(str_detect(suggested_speaker, "peel_")) %>% # Keep speakers containing "peel_"
select(suggested_speaker, top, year, wordcount, class) %>% # Keep the relevant columns
head() %>% # Display the first six rows
kable() # Format the results as a table
