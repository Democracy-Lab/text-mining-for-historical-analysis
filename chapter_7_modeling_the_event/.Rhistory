# Calculate the total number of words spoken by each speaker
# - group_by() groups the data by speaker category and speaker
# - summarize() adds the total words spoken by each speaker
wordcount_per_speaker <- all_speakers_annotated %>%
group_by(class, suggested_speaker) %>% # Group by speaker category and speaker
summarize(wordcount_per_speaker = sum(wordcount)) # Calculate the total words spoken
# Find the most prolific speakers in each category
