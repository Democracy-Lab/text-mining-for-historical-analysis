# Find the most frequent words used by speakers recorded as Chancellor of the Exchequer
# - filter() keeps just relevant speakers and valid words
# - anti_join() removes stop words
# - group_by() groups words by suggested speaker
# - summarize() counts how often each word was used
# - top_n() keeps the 35 most frequent results
# - ungroup() removes the grouping
chancellor_of_the_exchequeur <- words_1830 %>%
filter(str_detect(speaker, "Exchequer"), # Find speakers
str_detect(word, "[a-z]"), # Keep alphabetic words
suggested_speaker != "", # Remove unidentified speakers
suggested_speaker != "chancellor of the exchequerr") %>% # Remove OCR errpr
anti_join(stop_words) %>% # Remove stop words
anti_join(custom_stop_words) %>% # Remove custom stop words
group_by(suggested_speaker, word) %>% # Group by speaker and word
summarize(n = n()) %>% # Count word frequency
top_n(35) %>% # Keep top 35
ungroup() # Remove grouping
# Show five random results
chancellor_of_the_exchequeur %>%
sample_n(5)
# Reorder words within each speaker and visualize their most frequent words
# - mutate() reorders words based on frequency within each speaker
# - ggplot() creates the visualization
# - geom_col() creates bars showing word frequency
# - scale_x_reordered() displays the reordered word labels
# - coord_flip() flips the axes for readability
# - facet_wrap() creates a separate panel for each speaker
# - labs() labels the axes
# - ggtitle() adds the graph title
ggplot(data = chancellor_of_the_exchequeur %>%
mutate(word = reorder_within(word, n, suggested_speaker)), # Reorder words by speaker
aes(x = word, y = n)) + # Set axes
geom_col() + # Create bars
scale_x_reordered() + # Reorder word labels
coord_flip() + # Flip axes
facet_wrap(~suggested_speaker, scales = "free") + # Separate by speaker
labs(x = "word", y = "number of uses") + # Label axes
ggtitle("Favorite Words of Each Chancellor of the Exchequer in the 1830s") # Add title
# Convert a character date into a date object
date1 <- mdy("6/24/1819")
date1
# Extract the year from the date
year1 <- year(date1)
year1
# Load debate metadata for the 1830s
data("debate_metadata_1830")
# Add debate metadata and extract the year from each speech
# - left_join() automatically matches rows using the shared sentence_id column
# - mutate() creates a year column from speechdate
hansard_1830_w_year <- hansard_1830 %>%
left_join(debate_metadata_1830) %>% # Add the debate metadata
mutate(year = year(speechdate)) # Extract the year from the speech date
# Display the first six rows of the dataset
# - head() keeps the first six rows
# - str_trunc() shortens long text for readability
# - kable() formats the results as a table
hansard_1830_w_year %>%
head() %>% # Keep the first six rows
mutate(text = str_trunc(text, 120)) %>% # Shorten the text column
kable() # Format the results as a table
# Remove the old tokenized dataset from memory
# - rm() deletes the object
# - gc() frees memory that is no longer being used
rm(words_1830)
gc()
# Add speaker metadata and tokenize the text
# - left_join() automatically matches rows using the shared sentence_id column
# - select() keeps only the columns needed for analysis
# - unnest_tokens() splits the text into individual words
words_1830_w_year <- hansard_1830_w_year %>%
left_join(speaker_metadata_1830) %>% # Add the speaker metadata
select(speaker, suggested_speaker, text, year) %>% # Keep the relevant columns
unnest_tokens(word, text) # Tokenize the text into words
# Display the first six rows of the tokenized dataset
# - head() keeps the first six rows
# - select() keeps only the speaker, word, and year columns
# - kable() formats the results as a table
words_1830_w_year %>%
head() %>% # Keep the first six rows
select(speaker, word, year) %>% # Keep the speaker, word, and year columns
kable() # Format the results as a table
# Count the number of words spoken by each speaker per year
# - filter() removes rows without a suggested speaker
# - group_by() groups words by speaker and year
# - summarize() counts the total words for each speaker per year
# - arrange() sorts speakers from highest to lowest word count
words_per_speaker_1830 <- words_1830_w_year %>%
filter(suggested_speaker != "") %>% # Keep identified speakers
group_by(speaker, year) %>% # Group by speaker and year
summarize(speaker_words_per_year = n()) %>% # Count words
arrange(desc(speaker_words_per_year)) # Sort by word count
head(words_per_speaker_1830)
data("hansard_1820")
data("speaker_metadata_1820")
data("file_metadata_1820")
# Find the speaker metadata for Mrs. Walrand
# - regex() searches for speaker names matching "Mrs ... Walrand"
# - ignore_case = TRUE matches uppercase and lowercase text
mrs_walrand_speaker_metadata <- speaker_metadata_1820 %>%
filter(str_detect(speaker, regex("Mrs(.*)Walrand", ignore_case = TRUE))) # Keep Mrs. Walrand's metadata
# Add the speech text for Mrs. Walrand
# - left_join() automatically matches rows using the shared sentence_id column
# - select() keeps only the debate ID and text
mrs_walrand_sentences <- left_join(mrs_walrand_speaker_metadata,
file_metadata_1820, by = "sentence_id") %>% # Add the file metadata
left_join(hansard_1820, by = "sentence_id") %>% # Add the Hansard text
select(debate_id, text) # Keep the debate ID and text
# Display sample sentences spoken by Mrs. Walrand
# - head() keeps the first six rows
# - str_trunc() shortens long text for readability
# - kable() formats the results as a table
mrs_walrand_sentences %>%
head() %>% # Keep the first six rows
mutate(text = str_trunc(text, 120)) %>% # Shorten the text column
kable(caption = "Sentences uttered by Mrs. Walrand in the 1820 Hansard debates.") # Format the results as a table
# Extract the text from the debate of interest
# - left_join() adds file metadata to the Hansard data using sentence ID
# - filter() keeps only sentences from debate with the ID 5142
# - select() keeps only the text column
entire_debate <- hansard_1820 %>%
left_join(file_metadata_1820, by = "sentence_id") %>% # Add file metadata
filter(debate_id == 5142) %>% # Keep debate 5142
select(text) # Keep the text column
# Create a table containing the first 20 sentences of the debate
debate_table <- tibble(text = head(entire_debate$text, 20)) # Keep first 20 sentences
# Display the first 20 sentences of the debate as a formatted table
debate_table %>%
kable(caption = "Excerpt of Debate Text (First 20 Sentences)")
# Find Mrs. Walrand's 30 most frequently used words
# - left_join() automatically matches rows using the shared sentence_id column
# - unnest_tokens() splits the text into individual words
# - anti_join() removes common stop words
# - filter() removes numeric tokens
# - group_by() groups the words by speaker and word
# - summarize() counts the occurrences of each word
# - arrange() sorts the results from most to fewest occurrences
# - top_n() keeps the 30 most frequent words
mrs_walrand_top_words <- left_join(mrs_walrand_speaker_metadata, hansard_1820) %>%
unnest_tokens(word, text) %>% # Tokenize the text into words
anti_join(stop_words) %>% # Remove common stop words
filter(is.na(as.numeric(word))) %>% # Remove numeric tokens
group_by(speaker, word) %>% # Group by speaker and word
summarize(n = n()) %>% # Count the occurrences of each word
arrange(desc(n)) %>% # Sort from most to fewest occurrences
top_n(30) # Keep the 30 most frequent words
# Visualize Mrs. Walrand's most frequently used words
# - aes() maps words and word counts to the plot
# - geom_col() creates a bar chart
# - coord_flip() flips the axes for readability
# - labs() adds the title and axis labels
ggplot(data = mrs_walrand_top_words,
aes(x = reorder(word, n), # Order words by frequency
y = n)) + # Plot word counts
geom_col() + # Create the bars
coord_flip() + # Flip the axes
labs(title = "Mrs. Walrand's Top Words", # Add the chart title
subtitle = "From \"Motion Respecting the Trial and Condemnation of
Missionary Smith at Demerara\"", # Add a subtitle
x = "Word", # Label the x-axis
y = "Count") # Label the y-axis
print(hansard)
# Create a dataset of speeches made before the Second Reform Act
# - select() keeps the columns needed for analysis
# - filter() keeps speeches from June 4, 1822 through June 3, 1832
# - mutate() extracts the year and labels the period
prereform <- hansard %>%
select(sentence_id, speechdate, debate, text, speaker, suggested_speaker) %>% # Keep the relevant columns
filter(speechdate >= as.Date("1822-06-04"), # Keep speeches on or after June 4, 1822
speechdate < as.Date("1832-06-04")) %>% # Keep speeches before June 4, 1832
mutate(year = year(speechdate), # Extract the year from the speech date
period = "prereform") # Label the speeches as prereform
# Load Hansard data and metadata for the 1840s
data("hansard_1840")
data("speaker_metadata_1840")
data("debate_metadata_1840")
# Add speaker and debate metadata to each decade of Hansard data
# - left_join() automatically matches rows using the shared sentence_id column
hansard_1820 <- hansard_1820 %>%
left_join(speaker_metadata_1820) %>% # Add speaker metadata
left_join(debate_metadata_1820) # Add debate metadata
hansard_1830 <- hansard_1830 %>%
left_join(speaker_metadata_1830) %>% # Add speaker metadata
left_join(debate_metadata_1830) # Add debate metadata
hansard_1840 <- hansard_1840 %>%
left_join(speaker_metadata_1840) %>% # Add speaker metadata
left_join(debate_metadata_1840) # Add debate metadata
# Combine the 1820s, 1830s, and 1840s Hansard data
# - bind_rows() stacks the rows from all three decades
hansard <- bind_rows(hansard_1820, hansard_1830, hansard_1840) # Combine the three datasets
# Create a dataset of speeches made before the Reform Act
# - select() keeps the columns needed for analysis
# - filter() keeps speeches from June 4, 1822 through June 3, 1832
# - mutate() extracts the year and labels the period
prereform <- hansard %>%
select(sentence_id, speechdate, debate, text, speaker, suggested_speaker) %>% # Keep text, date, debate, and speaker information
filter(speechdate >= as.Date("1822-06-04"), # Keep speeches from ten years before reform
speechdate < as.Date("1832-06-04")) %>% # Keep speeches made before the reform date
mutate(year = year(speechdate), # Extract the year from the speech date
period = "prereform") # Label the speeches as prereform
# Create a dataset of speeches made after the Reform Act
# - select() keeps the columns needed for analysis
# - filter() keeps speeches from June 4, 1832 through June 4, 1842
# - mutate() extracts the year and labels the period
postreform <- hansard %>%
select(sentence_id, speechdate, debate, text, speaker, suggested_speaker) %>% # Keep text, date, debate, and speaker information
filter(speechdate >= as.Date("1832-06-04"), # Keep speeches made on or after the reform date
speechdate <= as.Date("1842-06-04")) %>% # Keep speeches through ten years after reform
mutate(year = year(speechdate), # Extract the year from the speech date
period = "postreform") # Label the speeches as postreform
# Combine the prereform and postreform data
# - bind_rows() stacks the rows from both periods
both_periods <- bind_rows(prereform, postreform) # Combine the two periods
# Count the words used in each period
# - select() keeps only the period and text columns
# - unnest_tokens() splits the text into individual words
# - anti_join() removes common stop words
# - count() counts the occurrences of each word by period
both_periods_word_count <- both_periods %>%
select(period, text) %>% # Keep the period and text columns
unnest_tokens(word, text) %>% # Break the text into words
anti_join(stop_words, by = "word") %>% # Remove common stop words
count(period, word, name = "wordcount") # Count each word by period
# Calculate the total number of words in each period
# - group_by() groups the word counts by period
# - summarize() adds the word counts within each period
both_periods_word_count_totals <- both_periods_word_count %>%
group_by(period) %>% # Group the words by period
summarize(total = sum(wordcount)) # Calculate the total words
# Find the difference in total words spoken between the two periods
# - subtract the prereform total from the postreform total
both_periods_word_count_totals$total[1] - both_periods_word_count_totals$total[2]
both_periods_word_count_totals$total[1]
knitr::opts_chunk$set(echo = TRUE)
