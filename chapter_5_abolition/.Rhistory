# - filter() removes tokens that contain only numbers
# - anti_join() removes common stop words
# - mutate() lemmatizes each word
filtered_words_per_top_slavery_speaker_1833 <- top_slavery_speakers_1833 %>% # Start with the selected speakers
unnest_tokens(word, text) %>% # Break the text into words
filter(!str_detect(word, "^\\d+$")) %>% # Remove numbers
anti_join(stop_words, by = "word") %>% # Remove stop words
mutate(word = lemmatize_words(word)) # Lemmatize the words
