# - arrange() sorts speakers from most to fewest words
# - slice() keeps the top 20 rows
words_per_speaker_slavery_1833 <- slavery_debates_1833 %>%
unnest_tokens(word, text) %>% # Break the text into words
group_by(speaker) %>% # Group by speaker
summarize(words_per_speaker = n()) %>% # Count words per speaker
arrange(desc(words_per_speaker)) %>%  # Sort from most to fewest words
slice(1:20) # Keep the top 20 rows
