# - select() keeps only the sentence_id and text columns
hansard_trim <- hansard_1830 %>%
select(sentence_id, text)
# Keep the sentence IDs and speaker names
# - select() keeps only the sentence_id and speaker columns
speaker_meta_trim <- speaker_metadata_1830 %>%
select(sentence_id, speaker)
# Keep the sentence IDs and speech IDs
# - select() keeps only the sentence_id and speech_id columns
file_meta_trim <- file_metadata_1830 %>%
select(sentence_id, speech_id)
# Keep the sentence IDs and speech dates
# - select() keeps only the sentence_id and speechdate columns
debate_meta_trim <- debate_metadata_1830 %>%
select(sentence_id, speechdate)
# Find the full text of the speeches where the original sentences originated
# - select() keeps only the sentence IDs
# - left_join() adds the sentence text and metadata
# - group_by() groups the data by speech
# - summarize() combines the sentences into complete speeches
# - mutate() adds the speech date and speaker name
peel_speeches <- peel_sentences %>%
select(sentence_id) %>% # Keep only the sentence IDs
left_join(hansard_trim, by = "sentence_id") %>% # Add the sentence text
left_join(speaker_meta_trim, by = "sentence_id") %>% # Add the speaker names
left_join(file_meta_trim, by = "sentence_id") %>% # Add the speech IDs
left_join(debate_meta_trim, by = "sentence_id") %>% # Add the speech dates
group_by(speech_id, speaker, speechdate) %>% # Group by speech
summarize(speech = paste(text, collapse = " ")) %>% # Combine the sentences
mutate(speech = paste0(speechdate, ": ",
toupper(speaker), ": ",
speech)) %>% # Add the date and speaker
select(speech) # Keep only the speech text
peel_speeches %>%
mutate(speech = str_trunc(speech, 520)) %>%  #
kable(caption = "Three Speeches by Peel about Slavery Invoking the Word 'Wages'")
# Count the words used in speeches containing a search term
# - data supplies the corpus or subset of speeches
# - search_term supplies the word to search for
# - period_label supplies the label for the time period
count_collocates <- function(data, search_term, period_label) {
data %>%
mutate(when = period_label) %>% # Label the time period
filter(str_detect(tolower(text), search_term)) %>% # Keep speeches containing the search term
unnest_tokens(word, text) %>% # Tokenize the text into words
anti_join(stop_words, by = "word") %>% # Remove stop words
group_by(when, word) %>% # Group by time period and word
reframe(n = n()) %>% # Count word occurrences
arrange(desc(n)) } # Sort from most to fewest occurrences
# Find the most distinctive words in each time period
# - bind_rows() combines the two time periods
# - bind_tf_idf() calculates the tf-idf score for each word
# - group_by() groups the results by time period
# - slice_max() keeps the words with the highest tf-idf scores
find_distinctive_words <- function(before_data, after_data, top_words = 15) {
bind_rows(before_data, after_data) %>% # Combine the two time periods
bind_tf_idf(word, when, n) %>% # Calculate tf-idf scores
group_by(when) %>% # Group by time period
slice_max(tf_idf, n = top_words) %>% # Keep the top words
ungroup() %>% # Remove the grouping
arrange(when, desc(tf_idf))} # Sort by period and tf-idf score
# Keep only the slavery debates before 1833
# - filter() keeps only speeches before 1833
slavery_debates_before_1833 <- slavery_1830 %>%
filter(year < 1833)
freedom_collocates_before_1833 <- count_collocates(slavery_debates_before_1833,
search_term = "free",
period_label = "1830-32")
# Find the top 30 collocates
top_freedom_collocates_before_1833 <- freedom_collocates_before_1833 %>%
top_n(30)
top_freedom_collocates_before_1833
# Keep only the slavery debates after 1833
# - filter() keeps only speeches after 1833
slavery_debates_after_1833 <- slavery_1830 %>%
filter(year > 1833) # Keep only speeches after 1833
freedom_collocates_after_1833 <- count_collocates(slavery_debates_after_1833,
search_term = "free",
period_label = "1834-36")
# Find the top 30 collocates
top_freedom_collocates_after_1833 <- freedom_collocates_after_1833 %>%
top_n(30)
top_freedom_collocates_after_1833
# Find the most distinctive words in each time period
tf_idf_freedom_collocates <- find_distinctive_words(
freedom_collocates_before_1833,
freedom_collocates_after_1833
)
# Display the most distinctive words before 1833
# - filter() keeps only the earlier time period
# - select() removes the time period column
# - kable() displays the results as a table
tf_idf_freedom_collocates %>%
filter(when == "1830-32") %>%                  # Keep the earlier time period
select(-when) %>%                              # Remove the time period column
kable(caption = "1830-32")                     # Display the results as a table
# Make a Table
kable(tf_idf_freedom_collocates_before,
caption = "1830-32")
# Find the most distinctive words in each time period
# - find_distinctive_words() combines the periods, calculates tf-idf,
#   and keeps the top 15 words from each period
tf_idf_freedom_collocates <- find_distinctive_words(
freedom_collocates_before_1833,
freedom_collocates_after_1833,
top_words = 15
)
# Keep the most distinctive words before 1833
# - filter() keeps only the earlier time period
# - select() removes the time period column
tf_idf_freedom_collocates_before <- tf_idf_freedom_collocates %>%
filter(when == "1830-32") %>%                                  # Keep the earlier time period
select(-when)                                                  # Remove the time period column
# Keep the most distinctive words after 1833
# - filter() keeps only the later time period
# - select() removes the time period column
tf_idf_freedom_collocates_after <- tf_idf_freedom_collocates %>%
filter(when == "1834-36") %>%                                  # Keep the later time period
select(-when)                                                  # Remove the time period column
